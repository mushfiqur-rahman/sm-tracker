{
  "name": "postpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS for scheduling and publishing posts to every social network.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/scheduler.ts",
    "lint": "eslint .",
