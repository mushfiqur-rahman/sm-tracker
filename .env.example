# ---- Core ----
# MySQL / MariaDB. XAMPP default: user "root", empty password, port 3306.
# The "postpilot" database is created automatically by `npm run db:push`.
DATABASE_URL="mysql://root:@localhost:3306/postpilot"
APP_URL="http://localhost:3000"
# Long random string (openssl rand -base64 48). Signs sessions and encrypts social tokens.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Protects /api/cron/publish (for Vercel Cron or any external scheduler)
CRON_SECRET="change-me"
# When "true", platforms without OAuth credentials can be connected as sandbox accounts
# and publishing is simulated. Turn OFF in production.
DEMO_MODE="true"

# ---- Billing (Stripe) — optional. Without it, plan changes apply instantly (dev only). ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_BUSINESS=""

# ---- Social platform OAuth apps (set the ones you support) ----
# Redirect URI to register for each: {APP_URL}/api/social/callback/{platform}
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Instagram & Threads use Meta apps too
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
# Bluesky and Mastodon connect with handle + app password / instance token, no OAuth app needed.
